<!--
  App.xaml: the application definition (not a window).

  XAML is a user interface description language: an XML file where each tag is a
  visual element (button, text...). Here we only define "resources", that is,
  elements reused by every window.

  The style below applies to ALL buttons: large, high-contrast, readable and easy to
  aim at with the eyes. It also redefines the look on hover (light gray) and on press
  (blue), because the standard Windows look has little contrast on a dark background.

  There is no StartupUri: the code (App.xaml.cs) opens the first window.
-->
<Application
    x:Class="GazeBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3C4043" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#5F6368" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1A73E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
