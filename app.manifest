<?xml version="1.0" encoding="utf-8"?>
<!--
  app.manifest: information read by Windows when GazeBar.exe starts.

  Main purpose here: declare GazeBar "DPI aware" (DPI = dots per inch).

  The problem: with Windows scaling at 125 % or 150 %, a program that does not declare
  itself DPI aware receives "wrong" (scaled down) coordinates, and Windows enlarges its
  display, making it blurry. The eyetracker gaze, the cursor position and the WPF windows
  would then no longer use the same units: the circle would be offset.

  With this declaration, GazeBar works in REAL screen pixels (like the eyetracker gaze
  and the cursor). Only the overlay (OverlayWindow) converts these pixels to WPF units.

    PerMonitorV2  the best support (Windows 10 version 1703 and later);
    PerMonitor    fallback for older Windows versions.
  The old dpiAware tag is read by Windows versions that do not know dpiAwareness.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="GazeBar.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Runs with the user's rights, without asking for administrator rights. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 (same identifier). Required for per-monitor DPI in WPF. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
