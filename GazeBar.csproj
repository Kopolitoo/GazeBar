<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fichier de projet (.csproj) : il dit à MSBuild comment fabriquer le programme.

    Format moderne « SDK-style » : tous les fichiers .cs et .xaml du dossier sont
    trouvés automatiquement. Quand vous ajouterez un fichier, il n'y a rien à déclarer ici.

    Ce projet est une application WPF sur .NET Framework 4.8 (et non .NET 10), car la
    bibliothèque Tobii.Interaction, qui fournit le regard, n'existe que pour ce cadre, en 32 bits.
    C'est une application WPF : un programme Windows classique
    (« de bureau »), qui peut donc simuler la souris et le clavier, afficher des
    fenêtres transparentes, etc. Voir README.md.
  -->
  <PropertyGroup>
    <!-- WinExe = programme avec fenêtres (pas de console noire derrière). -->
    <OutputType>WinExe</OutputType>

    <!-- .NET Framework 4.8, fourni avec Windows. -->
    <TargetFramework>net48</TargetFramework>

    <!-- 32 bits : la bibliothèque native de l'eyetracker est chargée en 32 bits.
         Cela fonctionne très bien sur un Windows 64 bits. -->
    <PlatformTarget>x86</PlatformTarget>

    <!-- Version du langage C# : la plus récente disponible. -->
    <LangVersion>latest</LangVersion>

    <!-- Active WPF. -->
    <UseWPF>true</UseWPF>

    <RootNamespace>GazeBar</RootNamespace>
    <AssemblyName>GazeBar</AssemblyName>

    <!-- Deux options volontairement désactivées pour que le code reste explicite :
         - ImplicitUsings : sinon des « using » invisibles seraient ajoutés automatiquement ;
         - Nullable : sinon le compilateur signalerait beaucoup d'avertissements sur les valeurs « null ». -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Le « manifeste » : un petit fichier XML lu par Windows au lancement du programme.
         Il déclare GazeBar « sensible au DPI » : voir app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- L'icône du programme : celle qu'affichent l'Explorateur Windows, la barre des tâches,
         Alt+Tab et les raccourcis. Le fichier .ico contient la même image en plusieurs tailles
         (16, 24, 32, 48, 64 et 256 pixels) : Windows choisit la plus adaptée à l'écran.
         Les fenêtres WPF qui ne précisent pas d'icône reprennent automatiquement celle-ci. -->
    <ApplicationIcon>Ressources\GazeBar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Étape 12 : les dispositions du clavier au regard (fichiers JSON du dossier Claviers)
         sont copiées à côté de GazeBar.exe à chaque compilation, si elles ont changé.
         GazeBar les lit là (voir DispositionClavier.cs). -->
    <None Update="Claviers\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Étape 13 : le dictionnaire de la prédiction de mots (Dictionnaires/fr.txt, tiré de
         Lexique 3.83) et sa licence sont copiés de même à côté de GazeBar.exe
         (voir PredicteurMots.cs). -->
    <None Update="Dictionnaires\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le regard, via le moteur de l'eyetracker (même source que Mill Mouse).
         02/11/2026 : les DLL de l'eyetracker (Tobii) sont du code propriétaire, on ne les livre PAS avec
         GazeBar. Le paquet sert seulement à COMPILER :
         - ExcludeAssets="runtime" : les DLL .NET de l'eyetracker ne sont plus copiées à côté de GazeBar.exe ;
         - ExcludeAssets="build" : le petit script du paquet, qui copiait la DLL native
           Tobii.EyeX.Client.dll, n'est plus exécuté.
         Au démarrage, GazeBar va chercher ces DLL sur le PC (voir ChargeurEyetracker.cs). -->
    <PackageReference Include="Tobii.Interaction" Version="0.7.3" ExcludeAssets="runtime;build" />
  </ItemGroup>

  <!-- Ceinture et bretelles : si une DLL de l'eyetracker se retrouvait quand même à côté de
       GazeBar.exe (ancienne compilation, autre réglage…), on l'efface après chaque
       compilation, pour qu'elle ne parte jamais avec ce qu'on distribue.
       Le sous-dossier « Eyetracker » (copie faite par l'utilisateur lui-même) n'est pas touché. -->
  <Target Name="SupprimerDllEyetracker" AfterTargets="Build">
    <ItemGroup>
      <DllEyetrackerASupprimer Include="$(OutDir)Tobii.*.dll" />
    </ItemGroup>
    <Delete Files="@(DllEyetrackerASupprimer)" />
  </Target>
</Project>
