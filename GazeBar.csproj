<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Project file (.csproj): it tells MSBuild how to build the program.

    Modern "SDK-style" format: all the .cs and .xaml files of the folder are found
    automatically. When you add a file, there is nothing to declare here.

    This project is a WPF application on .NET Framework 4.8 (not .NET 10), because the
    Tobii.Interaction library, which provides the gaze, only exists for this framework, in 32 bits.
    It is a WPF application: a classic ("desktop") Windows program, which can therefore
    simulate the mouse and keyboard, show transparent windows, etc. See docs/architecture.md.
  -->
  <PropertyGroup>
    <!-- WinExe = program with windows (no black console behind it). -->
    <OutputType>WinExe</OutputType>

    <!-- .NET Framework 4.8, shipped with Windows. -->
    <TargetFramework>net48</TargetFramework>

    <!-- 32 bits: the eyetracker's native library is loaded in 32 bits.
         This works fine on a 64-bit Windows. -->
    <PlatformTarget>x86</PlatformTarget>

    <!-- C# language version: the latest available. -->
    <LangVersion>latest</LangVersion>

    <!-- Enables WPF. -->
    <UseWPF>true</UseWPF>

    <!-- The version number (MAJOR.MINOR.PATCH): PATCH grows for a fix, MINOR for a new
         feature, MAJOR for a big change (1.0.0 = first stable version).
         The release workflow (.github/workflows/release.yml) replaces it with the number typed
         when a version is published. It is written to the log at startup. -->
    <Version>0.1.0</Version>

    <RootNamespace>GazeBar</RootNamespace>
    <AssemblyName>GazeBar</AssemblyName>

    <!-- Two options deliberately disabled so that the code stays explicit:
         - ImplicitUsings: otherwise invisible "using" directives would be added automatically;
         - Nullable: otherwise the compiler would report many warnings about "null" values. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- The "manifest": a small XML file read by Windows when the program starts.
         It declares GazeBar "DPI aware": see app.manifest. (The "full installation"
         uses app.uiaccess.manifest instead: see below.) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The program icon: the one shown by Windows Explorer, the taskbar, Alt+Tab and
         shortcuts. The .ico file contains the same image in several sizes
         (16, 24, 32, 48, 64 and 256 pixels): Windows picks the best one for the screen.
         WPF windows that do not set an icon automatically use this one. -->
    <ApplicationIcon>Resources\GazeBar.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- "Full installation" build, with UI access (see Platform/UiAccess.cs):
         dotnet build GazeBar.csproj -c Release -p:UiAccess=true
       It uses app.uiaccess.manifest (uiAccess="true"). Such a GazeBar.exe only starts once
       signed and installed in C:\Program Files: it can NOT be started from Visual Studio
       or from the build folder. Without this property (Visual Studio, simple .zip),
       app.manifest is used and GazeBar starts from anywhere. -->
  <PropertyGroup Condition="'$(UiAccess)' == 'true'">
    <ApplicationManifest>app.uiaccess.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The gaze keyboard layouts (JSON files of the Keyboards folder) are copied
         next to GazeBar.exe on each build, if they changed.
         GazeBar reads them there (see KeyboardLayout.cs). -->
    <None Update="Keyboards\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The word prediction dictionary (Dictionaries/fr.txt, taken from
         Lexique 3.83) and its license are copied next to GazeBar.exe in the same way
         (see WordPredictor.cs). -->
    <None Update="Dictionaries\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The interface language files (Languages/fr.json…), read by
         Texts.cs, are copied the same way. -->
    <None Update="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gaze, through the eyetracker engine (same source as Mill Mouse).
         The eyetracker (Tobii) DLLs are proprietary code, we do NOT ship them with
         GazeBar. The package is only used to COMPILE:
         - ExcludeAssets="runtime": the eyetracker .NET DLLs are not copied next to GazeBar.exe;
         - ExcludeAssets="build": the package's small script, which copied the native DLL
           Tobii.EyeX.Client.dll, does not run.
         At startup, GazeBar looks for these DLLs on the PC (see EyetrackerLoader.cs). -->
    <PackageReference Include="Tobii.Interaction" Version="0.7.3" ExcludeAssets="runtime;build" />
  </ItemGroup>

  <!-- Belt and braces: if an eyetracker DLL still ended up next to GazeBar.exe (old build,
       other setting...), it is deleted after each build, so that it never ships with what
       we distribute.
       The "Eyetracker" subfolder (a copy made by the user himself) is not touched. -->
  <Target Name="RemoveEyetrackerDlls" AfterTargets="Build">
    <ItemGroup>
      <EyetrackerDllToRemove Include="$(OutDir)Tobii.*.dll" />
    </ItemGroup>
    <Delete Files="@(EyetrackerDllToRemove)" />
  </Target>
</Project>
