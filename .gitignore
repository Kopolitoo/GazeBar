# Build output
bin/
obj/
AppPackages/
BundleArtifacts/
*.nupkg

# Visual Studio and editor files
.vs/
*.user
*.suo
.vscode/*
!.vscode/settings.json

# NuGet packages downloaded locally
packages/

# Signing certificates and keys: NEVER publish them
*.pfx
*.snk
*.cer

# Eyetracker (Tobii) DLLs: proprietary, never in the repository
Eyetracker/
Tobii.*.dll

# Logs
*.log

# Personal data, never in the repository:
# - the personal dictionary of the gaze keyboard (it can contain names, addresses...);
# - settings and profiles copied from a computer;
# - any gaze positions file (the eyetracker licence forbids saving gaze data).
personal-dictionary*.json
*.perso.*
/settings.json
Profiles/
positions-*.csv
