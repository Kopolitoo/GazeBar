<!--
  OverlayWindow.xaml: the "overlay", a transparent window covering the whole screen.

  This is where GazeBar draws what must appear on top of the other applications (the
  circle following the gaze, the progress ring, the options icon...).
  It must NEVER get in the way of the target application:
    - it is invisible, except what is drawn on it;
    - clicks go through it (set in code, OverlayWindow.xaml.cs);
    - it never takes the focus.

  Window settings:
    WindowStyle="None" + AllowsTransparency="True" + Background="Transparent"
                                  borderless window whose background is really transparent
    Topmost="True"                always above the other windows
    ShowInTaskbar="False"         not in the taskbar
    ShowActivated="False"         does not take the focus when it opens
    IsHitTestVisible="False"      WPF does not even check whether the mouse touches it
  Its position and size (the whole screen) are computed in code, taking the Windows
  scaling into account (125 %, 150 %...).

  The circle is drawn twice, one on top of the other: a black line underneath and a thinner
  green line on top, half transparent (Opacity="0.5") to stay discreet. This way it stays
  visible on a light background as well as a dark one. In fixed gaze mode, the top line
  becomes white and opaque: one sees at once that the circle is frozen.

  Elements added in step 2 (movement mode):
    Ring              the progress ring: a thick arc filling up on the edge of the circle,
                      clockwise, starting from the top;
    OptionsIcon       the options icon of fixed gaze mode: a dark square with rounded corners
                      containing a symbol of the Windows font ("...", code E712);
    OptionsIconFlash  the light flash of the icon when it is looked at: a green layer on the
                      icon whose opacity follows the progress (replaces the ring that was
                      drawn around the icon, user request of 2026-11-02);
    OptionsLabel      the "Options" text shown under the icon when it is looked at (if
                      ShowLabels is on).
  Element added in step 3 (action choice):
    ChoiceScreen      the black screen of action choice mode. It covers the whole overlay, on
                      top of the rest. Its content (enlarged capture, cross, action icons and
                      their rings) is created in code (ActionChoiceMode and GazeButton). Since
                      the overlay stays transparent to clicks, this black screen never catches
                      the mouse.
  Element added in step 4 (menu mode):
    MenuBar           the menu bar surface, at the bottom of the screen. It covers the whole
                      overlay but stays transparent: only the bar and its buttons, created in
                      code (MenuMode and GazeButton), are visible. It is placed BEFORE the
                      black screen, so drawn underneath it.
  Element added in step 6 (drag and drop):
    DragSurface       the surface for choosing the drop point of a drag and drop: the dotted
                      line of the path and the "back" button on the right edge. Transparent,
                      like the menu bar: the real screen is seen underneath.
  Element added in step 12 (gaze keyboard):
    KeyboardSurface   the keyboard, at the bottom of the screen (see GazeKeyboard). It is
                      opaque but, like the whole overlay, lets the clicks of a real mouse
                      through and never takes the focus: the application being typed into
                      keeps its text cursor.
  The symbols come from the "Segoe Fluent Icons" font (Windows 11) or, failing that,
  "Segoe MDL2 Assets" (Windows 10): WPF takes the first one present on the computer.
-->
<Window
    x:Class="GazeBar.OverlayWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GazeBar (calque)"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    Focusable="False"
    IsHitTestVisible="False">

    <!-- Canvas: a surface where elements are placed by coordinates (Canvas.Left / Canvas.Top). -->
    <Canvas x:Name="Surface">
        <!-- Gaze keyboard surface (step 12). Placed FIRST: it is drawn underneath everything
             else (circle, options icon, menu bar...). Its size and content are set in code
             (GazeKeyboard). -->
        <Canvas x:Name="KeyboardSurface" Visibility="Collapsed" />

        <Ellipse x:Name="CircleBackground" Stroke="LightGray" StrokeThickness="2" Opacity="0.5" Visibility="Collapsed" />
        <Ellipse x:Name="Circle" Stroke="DarkGray" StrokeThickness="1" Opacity="0.3" Visibility="Collapsed" />

        <!-- Progress ring of the circle. Its shape (Data) is computed in code. -->
        <Path x:Name="Ring" Stroke="#FF00C853" StrokeThickness="6" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" Visibility="Collapsed" />

        <!-- Options icon of fixed gaze mode. Its size and position are set in code. -->
        <!-- OptionsIconFlash: green layer under the symbol, invisible at rest (Opacity 0); it
             lights up while the icon is looked at. Its corners are set in code. -->
        <Border x:Name="OptionsIcon" Background="#D0202124" BorderBrush="White" BorderThickness="2"
                CornerRadius="12" Visibility="Collapsed">
            <Grid>
                <Border x:Name="OptionsIconFlash" Background="#FF00C853" Opacity="0" />
                <TextBlock x:Name="OptionsIconSymbol" Text="&#xE712;" Foreground="White"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border x:Name="OptionsLabel" Background="#E0202124" CornerRadius="6" Padding="8,2"
                Visibility="Collapsed">
            <TextBlock x:Name="OptionsLabelText" Text="Options" Foreground="White" FontSize="20" />
        </Border>

        <!-- Drag and drop surface (step 6). Its size and content are set in code. -->
        <Canvas x:Name="DragSurface" Visibility="Collapsed" />

        <!-- Menu bar surface (step 4). Its size and content are set in code. -->
        <Canvas x:Name="MenuBar" Visibility="Collapsed" />

        <!-- Black screen of action choice mode (step 3). Its size is set in code. -->
        <Canvas x:Name="ChoiceScreen" Background="Black" Visibility="Collapsed" />
    </Canvas>
</Window>
