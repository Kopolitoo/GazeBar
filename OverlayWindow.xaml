<!--
  OverlayWindow.xaml : le « calque », une fenêtre transparente qui couvre tout l'écran.

  C'est sur elle que GazeBar dessine ce qui doit apparaître par-dessus les autres
  applications (le cercle qui suit le regard, l'anneau de progression, l'icône d'options…).
  Elle ne doit JAMAIS gêner l'application visée :
    - elle est invisible, sauf ce qu'on y dessine ;
    - les clics la traversent (réglé dans le code, OverlayWindow.xaml.cs) ;
    - elle ne prend jamais le focus.

  Réglages de la fenêtre :
    WindowStyle="None" + AllowsTransparency="True" + Background="Transparent"
                                  fenêtre sans bord, dont le fond est réellement transparent
    Topmost="True"                toujours au-dessus des autres fenêtres
    ShowInTaskbar="False"         absente de la barre des tâches
    ShowActivated="False"         ne prend pas le focus à son ouverture
    IsHitTestVisible="False"      WPF ne cherche même pas à savoir si la souris la touche
  Sa position et sa taille (tout l'écran) sont calculées dans le code, en tenant compte
  de la mise à l'échelle de Windows (125 %, 150 %…).

  Le cercle est dessiné deux fois, l'un sur l'autre : un trait noir dessous et un trait vert
  plus fin dessus, à moitié transparents (Opacity="0.5") pour rester discrets. Ainsi il reste
  visible sur un fond clair comme sur un fond sombre. En mode regard fixe, le trait de dessus
  devient blanc et opaque : on voit tout de suite que le cercle est figé.

  Éléments ajoutés à l'étape 2 (mode mouvement) :
    Anneau        l'anneau de progression : un arc épais qui se remplit sur le bord du cercle,
                  dans le sens des aiguilles d'une montre, en partant du haut ;
    Icone         l'icône d'options du mode regard fixe : un carré sombre aux coins arrondis
                  qui contient un symbole de la police Windows (« … », code E712) ;
    AnneauIcone   l'anneau qui se remplit autour de l'icône quand on la regarde ;
    Libelle       le texte « Options » affiché sous l'icône quand on la regarde (si
                  AfficherLibelles est activé).
  Élément ajouté à l'étape 3 (choix d'action) :
    EcranChoix    l'écran noir du mode choix d'action. Il couvre tout le calque, par-dessus le
                  reste. Son contenu (capture agrandie, croix, icônes d'action et leurs anneaux)
                  est créé dans le code (ModeChoixAction et BoutonRegard). Le calque restant
                  transparent aux clics, cet écran noir ne capte jamais la souris.
  Élément ajouté à l'étape 4 (mode menu) :
    BarreMenu     la surface de la barre de menu, en bas de l'écran. Elle couvre tout le calque
                  mais reste transparente : seuls la barre et ses boutons, créés dans le code
                  (ModeMenu et BoutonRegard), sont visibles. Elle est placée AVANT l'écran
                  noir, donc dessinée en dessous de lui.
  Les symboles viennent de la police « Segoe Fluent Icons » (Windows 11) ou, à défaut,
  « Segoe MDL2 Assets » (Windows 10) : WPF prend la première présente sur l'ordinateur.
-->
<Window
    x:Class="GazeBar.OverlayWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GazeBar (calque)"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    Focusable="False"
    IsHitTestVisible="False">

    <!-- Canvas : une surface où l'on place les éléments par coordonnées (Canvas.Left / Canvas.Top). -->
    <Canvas x:Name="Surface">
        <Ellipse x:Name="CercleFond" Stroke="#B0000000" StrokeThickness="2" Opacity="0.5" Visibility="Collapsed" />
        <Ellipse x:Name="Cercle" Stroke="Green" StrokeThickness="1" Opacity="0.5" Visibility="Collapsed" />

        <!-- Anneau de progression du cercle. Sa forme (Data) est calculée dans le code. -->
        <Path x:Name="Anneau" Stroke="#FF00C853" StrokeThickness="6" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" Visibility="Collapsed" />

        <!-- Icône d'options du mode regard fixe. Sa taille et sa place sont réglées dans le code. -->
        <Border x:Name="Icone" Background="#D0202124" BorderBrush="White" BorderThickness="2"
                CornerRadius="12" Visibility="Collapsed">
            <TextBlock x:Name="IconeSymbole" Text="&#xE712;" Foreground="White"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Path x:Name="AnneauIcone" Stroke="#FF00C853" StrokeThickness="6" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" Visibility="Collapsed" />
        <Border x:Name="Libelle" Background="#E0202124" CornerRadius="6" Padding="8,2"
                Visibility="Collapsed">
            <TextBlock x:Name="LibelleTexte" Text="Options" Foreground="White" FontSize="20" />
        </Border>

        <!-- Surface de la barre de menu (étape 4). Sa taille et son contenu sont réglés dans le code. -->
        <Canvas x:Name="BarreMenu" Visibility="Collapsed" />

        <!-- Écran noir du mode choix d'action (étape 3). Sa taille est réglée dans le code. -->
        <Canvas x:Name="EcranChoix" Background="Black" Visibility="Collapsed" />
    </Canvas>
</Window>
