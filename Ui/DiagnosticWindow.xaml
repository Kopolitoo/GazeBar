<!--
  DiagnosticWindow.xaml: diagnostic window for "gaze through the cursor".

  It answers the question: is the cursor driven by the eyetracker software a good
  substitute for the gaze? It shows:
    - the cursor position (valid on the WHOLE screen, even outside this window);
    - how many times per second it changes (the real rate);
    - a thumbnail of the screen with a dot (the cursor) and its recent trail.
    - the gaze steadiness in three bands of the screen (top, middle, bottom), see
      GazeStability.cs: only counters, no position.
  Nothing is written to disk: the eyetracker licence forbids storing gaze data.

  The thumbnail is a Canvas: an area where elements are placed at exact coordinates.
  The elements drawn in it (dot, trail) are created in code (DiagnosticWindow.xaml.cs).
-->
<Window
    x:Class="Prunel.DiagnosticWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    Background="#202124"
    Foreground="White">

    <StackPanel Margin="16">

        <TextBlock x:Name="PositionText" FontSize="32" FontWeight="SemiBold" Text="…" />
        <TextBlock x:Name="RateText" FontSize="22" Margin="0,6,0,0" Text="…" />
        <TextBlock x:Name="GazeReadText" FontSize="24" Margin="0,6,0,0" Foreground="#81C995" Text="…" />
        <TextBlock x:Name="IdleText" FontSize="22" Margin="0,2,0,0" Text="" />
        <TextBlock x:Name="ScreenInfoText" FontSize="18" Margin="0,2,0,10" Foreground="#9AA0A6" Text="" />

        <Border BorderBrush="#5F6368" BorderThickness="1" HorizontalAlignment="Left">
            <Canvas x:Name="MapCanvas" Background="#101114" ClipToBounds="True" />
        </Border>

        <!-- Gaze steadiness by band of the screen (filled in code). -->
        <TextBlock x:Name="StabilityTitleText" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" Text="" />
        <TextBlock x:Name="StabilityHelpText" FontSize="16" Margin="0,2,0,4" Foreground="#9AA0A6"
                   TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Text="" />
        <TextBlock x:Name="StabilityTopText" FontSize="20" Text="" />
        <TextBlock x:Name="StabilityMiddleText" FontSize="20" Text="" />
        <TextBlock x:Name="StabilityBottomText" FontSize="20" Text="" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ResetButton" Content="" Click="OnResetClick" Margin="0,0,10,0" />
            <Button x:Name="CloseButton" Content="" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
